# Database
POSTGRES_USER=cakeerp
POSTGRES_PASSWORD=cakeerp_pass
POSTGRES_DB=cakeerp
DATABASE_URL=postgresql://cakeerp:cakeerp_pass@localhost:5432/cakeerp

# JWT
JWT_SECRET=super-secret-cake-key-change-in-production
JWT_EXPIRES_IN=24h

# Server
PORT=4000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# SMTP (Cash Controlling missing-submission alerts). Leave SMTP_HOST unset to log emails
# instead of sending them (useful for local dev without real credentials).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=cakeerp@localhost
